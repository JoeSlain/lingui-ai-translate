{
	"name": "lingui-ai-translate",
	"version": "0.2.0",
	"description": "Translate Lingui .po files using OpenAI. CLI and library.",
	"keywords": [
		".po",
		"cli",
		"gettext",
		"lingui",
		"openai",
		"translate"
	],
	"license": "MIT",
	"author": "Joe Slain",
	"bin": {
		"lingui-ai-translate": "bin/lingui-ai-translate.js"
	},
	"files": [
		"bin",
		"src",
		"README.md",
		"examples"
	],
	"type": "module",
	"exports": {
		".": "./src/index.js"
	},
	"scripts": {
		"start": "node bin/lingui-ai-translate.js",
		"example:fr": "node bin/lingui-ai-translate.js -f examples/fr/messages.po -l fr",
		"example:de": "node bin/lingui-ai-translate.js -f examples/de/messages.po -l de",
		"test": "vitest run",
		"test:watch": "vitest",
		"test:integration": "vitest run --config vitest.integration.config.js"
	},
	"dependencies": {
		"@anthropic-ai/sdk": "^0.72.1",
		"@google/genai": "^1.39.0",
		"commander": "^12.1.0",
		"fast-glob": "^3.3.2",
		"gettext-parser": "^6.0.0",
		"openai": "^4.58.1",
		"ora": "^8.1.0"
	},
	"devDependencies": {
		"vitest": "^2.1.2"
	},
	"engines": {
		"node": ">=18"
	}
}
